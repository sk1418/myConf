{
  "title": "IM swtich options, Require Cmd+Space to switch from/to ABC",
  "rules": [
    {
      "description": "Right Shift to swtich IM",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "right_shift" },
          "to": [ { "key_code": "right_shift" } ],
          "to_if_alone": [ 
            { 
              "key_code": "spacebar",
              "modifiers": [ "command" ]
            }
          ]
        }
      ]
    },
    {
      "description": "Alt-Space to switch IM",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": {
              "mandatory": [ "option" ]
            }
          },
          "to": [
            {
              "key_code": "spacebar",
              "modifiers": [ "command" ]
            }
          ]
        }
      ]
    }
  ]
}
