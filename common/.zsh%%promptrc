#zsh Prompt, could be different for different host/machines. 

# https://zsh.sourceforge.io/Doc/Release/Prompt-Expansion.html#Visual-effects
# %F{} frontground %K{}

ZSH_GIT_PROMPT_SHOW_STASH=1


function git_prompt {
    #gp="$(git_super_status)"
    gp="$(gitprompt)"
    if [[ "$gp" == " " ]]; then
        gp=""
    fi
    echo "$gp"
}

if [[ "$OSTYPE" == "darwin"* ]]; then

    #company Mac, without Host, user
    export PROMPT='%F{240}%K{251}%BLHT-Mac%K{reset} %F{red}%B%*% %F{yellow} %/
%F{green}$%b $(git_prompt)'

else 

    #linux
    export PROMPT='%F{240}%K{251}%B%M%K{reset} %F{red}%B%*% %F{yellow} %/
%F{green}%n$%b $(git_prompt)'

fi


